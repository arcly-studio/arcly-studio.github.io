---
// Neutral 404 for the whole host. GitHub Pages may also show it for missing paths under project sites
// (/dirwise/…), so: no canonical/hreflang, no scripts, only root-absolute links and assets
// (/_astro/… from Astro, /fonts/…, /media/…). Both languages on one page. Same look as the home hero.
import Fonts from "../components/Fonts.astro";
import { icon } from "../lib/icons";
import arclyIcon from "../assets/brand/arcly-icon.svg?url";
import "../styles/site.css";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found · Arcly Studio</title>
    <meta name="robots" content="noindex" />
    <meta name="description" content="This page doesn't exist. Tahle stránka neexistuje. Go to Arcly Studio or Dirwise." />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0d16" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Fonts />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page-lines" aria-hidden="true"></div>
    <header class="nav-wrap">
      <nav class="nav nf-nav" aria-label="Arcly Studio">
        <a class="nav-brand" href="/"><img src={arclyIcon} width="22" height="22" alt="" /><span>Arcly Studio</span></a>
        <div class="nav-end">
          <div class="lang" role="group" aria-label="Language">
            <a href="/" hreflang="en" lang="en">EN</a>
            <a href="/cs/" hreflang="cs" lang="cs">CS</a>
          </div>
        </div>
      </nav>
    </header>
    <main id="main" class="nf">
      <section class="hero">
        <div class="hero-sky" aria-hidden="true" style="--stars: url(/media/stars.svg)"><div class="hero-glow"></div></div>
        <h1 class="hero-title"><em>404</em></h1>
        <div class="nf-cols">
          <div>
            <h2>This page doesn't exist.</h2>
            <p>The link may be old or mistyped.</p>
            <div class="hero-cta">
              <a class="btn btn-primary" href="/">Arcly Studio<Fragment set:html={icon("ArrowRight", 16)} /></a>
              <a class="btn btn-ghost" href="/dirwise/">Dirwise</a>
            </div>
          </div>
          <div lang="cs">
            <h2>Tahle stránka neexistuje.</h2>
            <p>Odkaz může být starý nebo s překlepem.</p>
            <div class="hero-cta">
              <a class="btn btn-primary" href="/cs/">Arcly Studio<Fragment set:html={icon("ArrowRight", 16)} /></a>
              <a class="btn btn-ghost" href="/dirwise/cs/">Dirwise</a>
            </div>
          </div>
        </div>
      </section>
    </main>
    <footer class="foot">
      <p><img src={arclyIcon} width="18" height="18" alt="" />© 2026 Arcly Studio</p>
    </footer>
  </body>
</html>
