---
// Page shell (structure as Dirwise/site/src/components/Layout.astro): <head> (meta, canonical, hreflang,
// fonts, motion bootstrap), announcement + navigation, content, footer, lazy animation module.
// `path` = page path without the language prefix ("" = home).
import { apps, appHref } from "../data/apps";
import { texts, links, EMAIL, home, type Lang } from "../i18n/texts";
import { brandIcon, brandName } from "../lib/icons";
import arclyIcon from "../assets/brand/arcly-icon.svg?url";
import Fonts from "./Fonts.astro";
import Nav from "./Nav.astro";
import "../styles/site.css";

interface Props { lang: Lang; path?: string; title: string; description: string }
const { lang, path = "", title, description } = Astro.props;
const t = texts[lang];

const pageHref = (l: Lang) => `${home(l)}${path}`;
const abs = (l: Lang) => new URL(pageHref(l), Astro.site).href;
const urls = { en: abs("en"), cs: abs("cs") };
const other: Lang = lang === "en" ? "cs" : "en";
const ogImage = new URL(`/og-${lang}.png`, Astro.site).href;
// Copyright year from the build (the site is rebuilt on every change) – never stale.
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0d16" />
    <link rel="canonical" href={urls[lang]} />
    <link rel="alternate" hreflang="en" href={urls.en} />
    <link rel="alternate" hreflang="cs" href={urls.cs} />
    <link rel="alternate" hreflang="x-default" href={urls.en} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Arcly Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={urls[lang]} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:locale:alternate" content={texts[other].ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={t.ogAlt} />
    <Fonts cs={lang === "cs"} />
    {/* Motion bootstrap (identical to the Dirwise site): without reduced motion mark the page "pending" –
        on desktop (>= 768 px) CSS hides the initial states and the module switches them to "on". Safety net:
        if the module has not started 4 s after load, the attribute is removed and everything is visible. */}
    <script is:inline>
      (function () {
        try {
          var r = matchMedia("(prefers-reduced-motion: reduce)");
          if (r.matches) return;
          var h = document.documentElement;
          h.dataset.motion = "pending";
          var clear = function () { if (h.dataset.motion === "pending") h.removeAttribute("data-motion"); };
          addEventListener("load", function () {
            setTimeout(function () { if (matchMedia("(min-width: 768px)").matches) clear(); }, 4000);
          });
          r.addEventListener("change", function () { if (r.matches) clear(); });
        } catch (e) {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <div class="page-lines" aria-hidden="true"></div>
    <Nav lang={lang} path={path} />
    <slot />

    <footer class="foot">
      <nav aria-label={t.footerNav}>
        <a href={links.org}>GitHub</a>
        <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
        {apps.map((app) => <a href={appHref(app, lang)}>{app.name}</a>)}
      </nav>
      {/* Social accounts of the apps (src/data/socials.ts), grouped by app; the studio has none of its own yet. */}
      <ul class="foot-socials" aria-label={t.footerSocials}>
        {apps.filter((app) => app.socials.length).map((app) => (
          <li>
            <span class="foot-socials-app">{app.name}</span>
            {app.socials.map((s) => (
              <a href={s.url} rel="noopener" aria-label={`${app.name} – ${brandName(s.network)} ${s.handle}`} title={`${brandName(s.network)} ${s.handle}`} set:html={brandIcon(s.network, 16)} />
            ))}
          </li>
        ))}
      </ul>
      <p><img src={arclyIcon} width="18" height="18" alt="" />© {year} Arcly Studio</p>
    </footer>

    <script>
      // Animation module (GSAP + Lenis) only without reduced motion – same loading strategy as the Dirwise
      // site: on desktop right away, on mobile on first interaction or 3 s after `load`.
      let booted = false;
      const boot = () => {
        if (booted) return;
        booted = true;
        import("../scripts/motion")
          .then((m) => { try { m.init(); } catch { m.abort(); } })
          .catch(() => document.documentElement.removeAttribute("data-motion"));
      };
      if (document.documentElement.dataset.motion === "pending") {
        if (matchMedia("(min-width: 768px)").matches) boot();
        else {
          const later = () => setTimeout(boot, 3000);
          if (document.readyState === "complete") later();
          else addEventListener("load", later, { once: true });
          for (const ev of ["scroll", "touchstart", "pointerdown", "keydown"]) addEventListener(ev, boot, { once: true, passive: true });
          matchMedia("(min-width: 768px)").addEventListener("change", boot, { once: true });
        }
      }
    </script>
  </body>
</html>
