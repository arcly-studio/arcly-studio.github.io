{
  "name": "arcly-studio-site",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/prepare.mjs",
    "build": "astro build && node scripts/guard.mjs && node scripts/check-words.mjs",
    "preview": "astro preview",
    "guard": "node scripts/guard.mjs",
    "test": "node --test scripts/*.test.mjs",
    "check:words": "node scripts/check-words.mjs",
    "sim": "node scripts/sim.mjs",
    "serve": "node scripts/serve-pages.mjs",
    "screens": "node scripts/screens.mjs",
    "check:types": "astro check",
    "og": "node scripts/og.mjs",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:seo": "node scripts/check-seo.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "check:all": "npm run check:types && npm test && npm run sim -- --no-serve && npm run guard && npm run check:words && npm run check:html && npm run check:seo && npm run check:links && npm run check:overflow",
    "check:all:local": "npm run check:types && npm test && npm run sim -- --no-serve --local-dirwise --local-noirpad && npm run guard && npm run check:words && npm run check:html && npm run check:seo && npm run check:links && npm run check:overflow -- --projects dirwise,noirpad",
    "sim:local-dirwise": "node scripts/sim.mjs --local-dirwise",
    "sim:local-noirpad": "node scripts/sim.mjs --local-noirpad",
    "sim:local": "node scripts/sim.mjs --local-dirwise --local-noirpad"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^7.4.7",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide": "^1.28.0",
    "sharp": "^0.35.5",
    "simple-icons": "^16.36.0",
    "subset-font": "^2.9.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "chrome-launcher": "^1.2.2",
    "html-validate": "^11.18.0",
    "lighthouse": "^13.6.0",
    "node-html-parser": "^9.0.6",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3"
  }
}
